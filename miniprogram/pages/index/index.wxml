<view class="page">
  <star-field />

  <scroll-view scroll-y class="scaffold {{tabAnim}}" enhanced bounces show-scrollbar="{{false}}" deceleration-rate="0.98">
    <!-- Hero 区：星空主题装饰图 -->
    <view class="hero">
      <view class="hero-emblem">
        <view class="emblem-ring"></view>
        <view class="emblem-core">思</view>
      </view>
      <text class="hero-title">思辨场</text>
      <text class="hero-sub">在星辰之间，与 AI 共思考</text>
    </view>

    <!-- 思辨段位 + 之旅（玻璃态卡：段位横条 + 统计三联） -->
    <view class="journey glass-card">
      <!-- 段位横条 -->
      <view class="journey-rank-row">
        <view class="rank-badge rank-{{profile.classify}}">
          <text class="rank-tier">{{profile.rank || '新手'}}</text>
        </view>
        <view class="rank-progress">
          <view class="rank-progress-info">
            <text class="rank-progress-cur">累计 {{profile.totalRounds || 0}} 轮</text>
            <text class="rank-progress-next" wx:if="{{profile.nextRank}}">距{{profile.nextRank}} 还需 {{profile.roundsToNext}} 轮</text>
            <text class="rank-progress-next rank-progress-max" wx:else>已达最高段位</text>
          </view>
          <view class="rank-progress-bar-bg">
            <view class="rank-progress-bar rank-bar-{{profile.classify}}" style="width: {{profile.rankProgress}}%"></view>
          </view>
        </view>
      </view>

      <view class="journey-divider"></view>

      <view class="journey-stats">
        <view class="stat">
          <text class="stat-value">{{journey.count}}</text>
          <text class="stat-label">完成场次</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat">
          <text class="stat-value">{{journey.best}}</text>
          <text class="stat-label">最佳得分</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat">
          <text class="stat-value">{{journey.mode}}</text>
          <text class="stat-label">最近模式</text>
        </view>
      </view>
    </view>

    <!-- 三种深度 -->
    <view class="modes">
      <text class="section-title">选择思辨深度</text>

      <!-- L1 -->
      <view class="mode glass-card stagger-item" style="--i: 0" bindtap="goSocrates" hover-class="card-hover" hover-stay-time="80">
        <view class="mode-side">
          <view class="mode-mark mark-l1">L1</view>
        </view>
        <view class="mode-main">
          <text class="mode-title">苏格拉底追问</text>
          <text class="mode-desc">AI 用反问帮你检验信念，不给答案</text>
          <view class="mode-foot">
            <text class="chip chip-l1">入门</text>
            <text class="mode-arrow">进入 ›</text>
          </view>
        </view>
      </view>

      <!-- L2 -->
      <view class="mode glass-card stagger-item" style="--i: 1" bindtap="goDual" hover-class="card-hover" hover-stay-time="80">
        <view class="mode-side">
          <view class="mode-mark mark-l2">L2</view>
        </view>
        <view class="mode-main">
          <text class="mode-title">双人共修</text>
          <text class="mode-desc">专家讲解 + 苏格拉底追问，交替进行</text>
          <view class="mode-foot">
            <text class="chip chip-l2">进阶</text>
            <text class="mode-arrow">进入 ›</text>
          </view>
        </view>
      </view>

      <!-- L3 -->
      <view class="mode glass-card stagger-item" style="--i: 2" bindtap="goDebate" hover-class="card-hover" hover-stay-time="80">
        <view class="mode-side">
          <view class="mode-mark mark-l3">L3</view>
        </view>
        <view class="mode-main">
          <text class="mode-title">三方辩论</text>
          <text class="mode-desc">正方 · 反方 · 裁判，你围观投票</text>
          <view class="mode-foot">
            <text class="chip chip-l3">高阶</text>
            <text class="mode-arrow">进入 ›</text>
          </view>
        </view>
      </view>
    </view>

    <view class="footnote">AI 生成内容仅供参考</view>
    <view class="bottom-spacer"></view>
  </scroll-view>

  <onboarding wx:if="{{showOnboarding}}" bind:done="onOnboardingDone" />
</view>
