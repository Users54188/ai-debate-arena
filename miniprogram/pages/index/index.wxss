.container {
  padding: 24px 16px;
  min-height: 100vh;
}

.hero {
  margin-bottom: 32px;
  text-align: center;
}

.hero-logo {
  width: 80px;
  height: 80px;
  margin: 0 auto 12px;
  border-radius: 16px;
}

.hero-title {
  display: block;
  font-size: 28px;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 8px;
}

.hero-subtitle {
  display: block;
  font-size: 15px;
  color: var(--text-secondary);
}

.rank-container {
  position: relative;
  margin-bottom: 32px;
  height: 180px;
}

.rank-border {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: var(--radius-lg);
}

.rank-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 20px;
}

.rank-title {
  display: block;
  font-size: 12px;
  color: var(--text-secondary);
  margin-bottom: 4px;
}

.rank-level {
  display: block;
  font-size: 20px;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 4px;
}

.rank-desc {
  display: block;
  font-size: 12px;
  color: var(--text-secondary);
}

.mode-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.mode-card {
  position: relative;
  overflow: hidden;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
 20px;
 36px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(79, 70, 229, 0.08);
}

.mode-locked {
  opacity: 0.7;
}

.mode-badge {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;
  margin-bottom: 8px;
}

.badge-l1 { background: #EEF2FF; color: var(--l1-socrates); }
.badge-l2 { background: #F0FDFA; color: var(--l2-expert); }
.badge-l3 { background: #FAF5FF; color: var(--l3-affirmative); }

.mode-title {
  display: block;
  font-size: 17px;
  font-weight: 600;
  margin-bottom: 4px;
}

.mode-desc {
  display: block;
  font-size: 13px;
  color: var(--text-secondary);
  margin-bottom: 8px;
}

.mode-quota {
  font-size: 12px;
  color: var(--success);
}

.mode-lock-tip {
  font-size: 12px;
  color: var(--warning);
}

.level-badge {
  position: absolute;
  top: 0;
  right: 0;
  width: 80px;
  height: 80px;
  opacity: 0.15;
}

.level-badge-l1 {
  transform: rotate(20deg);
}

.level-badge-l2 {
  transform: rotate(20deg);
}

.level-badge-l3 {
  transform: rotate(20deg);
}
