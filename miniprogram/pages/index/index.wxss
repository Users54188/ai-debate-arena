/* 首页 —— 星夜思辨入口 */

.page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, var(--night-1) 0%, var(--night-0) 100%);
}

.scaffold {
  position: relative;
  z-index: 1;
  height: 100%;
  box-sizing: border-box;
  padding: 0 var(--sp-4);
}

/* === Hero === */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0 48rpx;
  text-align: center;
}

.hero-emblem {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.emblem-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid var(--star-purple);
  box-shadow:
    0 0 32rpx rgba(157, 107, 255, 0.45),
    inset 0 0 32rpx rgba(157, 107, 255, 0.25);
  animation: ring-spin 18s linear infinite;
}

.emblem-ring::after {
  content: "";
  position: absolute;
  inset: 16rpx;
  border-radius: 50%;
  border: 1rpx dashed rgba(157, 107, 255, 0.45);
}

.emblem-core {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--star-purple), var(--star-indigo));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  box-shadow: 0 0 40rpx rgba(157, 107, 255, 0.6);
}

@keyframes ring-spin {
  to { transform: rotate(360deg); }
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--text-1);
  margin-bottom: 12rpx;
  text-shadow: 0 0 24rpx rgba(157, 107, 255, 0.5);
}

.hero-sub {
  font-size: var(--fs-body);
  color: var(--text-3);
  letter-spacing: 2rpx;
}

/* === Journey 卡 === */
.journey {
  padding: var(--sp-4);
  margin-bottom: var(--sp-5);
}

.journey-head {
  margin-bottom: var(--sp-3);
}

.journey-title {
  display: block;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 8rpx;
}

.journey-sub {
  display: block;
  font-size: var(--fs-caption);
  color: var(--text-3);
  letter-spacing: 1rpx;
}

.journey-stats {
  display: flex;
  align-items: center;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--star-purple);
  letter-spacing: 1rpx;
  text-shadow: 0 0 16rpx rgba(157, 107, 255, 0.4);
}

.stat-label {
  font-size: var(--fs-caption);
  color: var(--text-3);
  letter-spacing: 1rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: linear-gradient(180deg, transparent, var(--glass-border), transparent);
}

/* === Modes === */
.section-title {
  display: block;
  font-size: var(--fs-label);
  color: var(--text-3);
  letter-spacing: 4rpx;
  margin-bottom: var(--sp-3);
  text-transform: uppercase;
}

.modes {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.mode {
  display: flex;
  align-items: stretch;
  padding: var(--sp-4);
  transition: transform 120ms ease, border-color 200ms ease;
}

.card-hover {
  transform: scale(0.98);
  border-color: var(--glass-border-strong) !important;
}

.mode-side {
  flex-shrink: 0;
  padding-right: var(--sp-3);
  display: flex;
  align-items: center;
}

.mode-mark {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #FFFFFF;
  position: relative;
}

.mark-l1 {
  background: linear-gradient(135deg, var(--star-indigo), #4338CA);
  box-shadow: 0 0 24rpx rgba(99, 102, 241, 0.5);
}
.mark-l2 {
  background: linear-gradient(135deg, #06B6D4, #0E7490);
  box-shadow: 0 0 24rpx rgba(103, 232, 249, 0.45);
}
.mark-l3 {
  background: linear-gradient(135deg, var(--star-violet), #9333EA);
  box-shadow: 0 0 24rpx rgba(192, 132, 252, 0.5);
}

.mode-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mode-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--text-1);
}

.mode-desc {
  font-size: var(--fs-label);
  color: var(--text-3);
  line-height: 1.55;
}

.mode-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.chip {
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-caption);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.chip-l1 { background: rgba(99, 102, 241, 0.18); color: #A5B4FC; }
.chip-l2 { background: rgba(103, 232, 249, 0.16); color: #A5F3FC; }
.chip-l3 { background: rgba(192, 132, 252, 0.18); color: #E9D5FF; }

.mode-arrow {
  font-size: var(--fs-caption);
  color: var(--star-purple);
  letter-spacing: 1rpx;
}

.footnote {
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--text-4);
  padding: var(--sp-4) 0 var(--sp-3);
  letter-spacing: 1rpx;
}

.bottom-spacer {
  height: 120rpx;
}

/* 登录加载遮罩 */
.login-mask {
  position: fixed;
  inset: 0;
  z-index: 10000;
  background: var(--night-0, #07041F);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.login-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(157, 107, 255, 0.2);
  border-top-color: var(--star-purple, #9D6BFF);
  border-radius: 50%;
  animation: login-spin 0.8s linear infinite;
}

.login-text {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: var(--text-3, #8B86C7);
  letter-spacing: 2rpx;
}

@keyframes login-spin {
  to { transform: rotate(360deg); }
}
