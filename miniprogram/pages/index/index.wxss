.container {
  padding: 24px 16px;
  min-height: 100vh;
}

.hero {
  margin-bottom: 24px;
  text-align: center;
}

.hero-logo {
  width: 80px;
  height: 80px;
  margin: 0 auto 12px;
  border-radius: 16px;
}

.hero-title {
  display: block;
  font-size: 28px;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 8px;
}

.hero-subtitle {
  display: block;
  font-size: 15px;
  color: var(--text-secondary);
}

/* 思辨进度卡（journey-border 美工替换旧 rank-border） */
.journey-card {
  position: relative;
  margin-bottom: 24px;
  height: 160px;
}

.journey-border {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: var(--radius-lg);
}

.journey-content {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 16px;
}

.journey-title {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8px;
}

.journey-stats {
  display: flex;
  gap: 28px;
  margin-bottom: 6px;
}

.journey-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.journey-value {
  font-size: 20px;
  font-weight: 700;
  color: var(--primary);
}

.journey-label {
  font-size: 11px;
  color: var(--text-secondary);
}

.journey-desc {
  font-size: 11px;
  color: var(--text-secondary);
}

/* 三种模式入口 */
.mode-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.mode-card {
  position: relative;
  overflow: hidden;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 20px;
  box-shadow: 0 2px 8px rgba(79, 70, 229, 0.08);
}

.mode-badge {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;
  margin-bottom: 8px;
}

.badge-l1 { background: #EEF2FF; color: var(--l1-socrates); }
.badge-l2 { background: #F0FDFA; color: var(--l2-expert); }
.badge-l3 { background: #FAF5FF; color: var(--l3-affirmative); }

.mode-title {
  display: block;
  font-size: 17px;
  font-weight: 600;
  margin-bottom: 4px;
}

.mode-desc {
  display: block;
  font-size: 13px;
  color: var(--text-secondary);
  margin-bottom: 8px;
}

.mode-entrance {
  display: inline-block;
  font-size: 13px;
  font-weight: 500;
  color: var(--primary);
}

.level-badge {
  position: absolute;
  top: 0;
  right: 0;
  width: 80px;
  height: 80px;
  opacity: 0.15;
  transform: rotate(20deg);
}

.mode-decor {
  position: absolute;
  bottom: 10px;
  right: 14px;
  width: 40px;
  height: 40px;
  opacity: 0.5;
}