.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 16px;
  box-sizing: border-box;
}

.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding-top: 140px;
}

.state-text {
  font-size: 15px;
  color: var(--text-secondary);
}

.state-sub {
  font-size: 13px;
  color: var(--text-tertiary);
}

.rank-card {
  background: linear-gradient(135deg, #b45309, #d97706);
  border-radius: 16px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
  margin-bottom: 20px;
}

.rank-trophy {
  width: 56px;
  height: 56px;
  border-radius: 12px;
  margin-bottom: 8px;
}

.rank-name {
  font-size: 22px;
  font-weight: 700;
}

.rank-next {
  font-size: 12px;
  opacity: 0.9;
  margin-top: 4px;
}

.rank-progress {
  width: 100%;
  height: 8px;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4px;
  margin-top: 12px;
  overflow: hidden;
}

.rank-progress-bar {
  height: 100%;
  background: #fde68a;
  border-radius: 4px;
}

.section-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
  margin: 8px 2px 10px;
}

.row-list {
  background: var(--bg-card);
  border-radius: 14px;
  overflow: hidden;
}

.row-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 16px;
  border-bottom: 1px solid var(--border);
}

.row-item:last-child {
  border-bottom: none;
}

.row-mode {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
}

.row-label {
  flex: 1;
  font-size: 15px;
  color: var(--text-primary);
}

.row-score {
  font-size: 15px;
  font-weight: 600;
  color: var(--primary);
}

.row-time {
  font-size: 12px;
  color: var(--text-tertiary);
}