.report-page {
  padding: 24rpx 24rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5f3ff;
}

/* AI 生成角标 */
.ai-badge {
  position: fixed;
  top: 16rpx;
  right: 24rpx;
  z-index: 10;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(79, 70, 229, 0.12);
  color: #4f46e5;
  font-size: 20rpx;
}

/* 加载态 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #ddd6fe;
  border-top-color: #4f46e5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  margin-top: 24rpx;
  color: #6b7280;
  font-size: 26rpx;
}

/* 错误态 */
.error-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 300rpx;
}
.error-text {
  color: #6b7280;
  font-size: 28rpx;
}
.retry-btn {
  margin-top: 32rpx;
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #4f46e5;
  color: #fff;
  font-size: 28rpx;
}
.retry-btn::after { border: none; }

/* 雷达图 */
.radar-card {
  text-align: center;
}
.radar-canvas {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto;
}
.radar-labels {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 16rpx;
}
.radar-label-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #374151;
}
.dot-k { width: 12rpx; height: 12rpx; border-radius: 50%; background: #0EA5E9; flex-shrink: 0; }
.dot-d { width: 12rpx; height: 12rpx; border-radius: 50%; background: #8B5CF6; flex-shrink: 0; }

/* 分享视图提示 */
.share-hint {
  margin: 20rpx 32rpx 0;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 24rpx;
  text-align: center;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.06);
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 20rpx;
}

/* 评分卡 */
.score-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.score-ring {
  width: 260rpx;
  height: 260rpx;
}
.score-sub {
  display: flex;
  margin-top: 8rpx;
  width: 100%;
}
.sub-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.sub-label {
  font-size: 24rpx;
  color: #9ca3af;
}
.sub-value {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #4f46e5;
}

/* 策略条形图 */
.strategy-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}
.strategy-row:last-child { margin-bottom: 0; }
.strategy-label {
  width: 150rpx;
  font-size: 26rpx;
  color: #374151;
}
.strategy-track {
  flex: 1;
  height: 20rpx;
  background: #f3f4f6;
  border-radius: 999rpx;
  overflow: hidden;
}
.strategy-bar {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}
.strategy-bar.on { background: #4f46e5; }
.strategy-bar.off { background: #d1d5db; }
.strategy-mark {
  margin-left: 16rpx;
  width: 36rpx;
  font-size: 28rpx;
  text-align: center;
}
.strategy-mark.on { color: #4f46e5; }
.strategy-mark.off { color: #d1d5db; }

/* 谬误列表 */
.fallacy-item {
  display: flex;
  flex-direction: column;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #fafaff;
  margin-bottom: 16rpx;
}
.fallacy-item:last-child { margin-bottom: 0; }
.fallacy-type {
  align-self: flex-start;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #fee2e2;
  color: #dc2626;
  font-size: 22rpx;
}
.fallacy-quote {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #374151;
  line-height: 1.5;
}
.fallacy-round {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

/* 高光 */
.highlight-item {
  padding: 16rpx 20rpx;
  border-left: 6rpx solid #fbbf24;
  background: #fffbeb;
  border-radius: 8rpx;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  color: #92400e;
  line-height: 1.5;
}
.highlight-item:last-child { margin-bottom: 0; }

/* 报告正文 */
.degraded-tip {
  padding: 12rpx 20rpx;
  background: #fef3c7;
  color: #92400e;
  border-radius: 10rpx;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}
.report-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 对话回溯 */
.transcript-scroll {
  max-height: 600rpx;
}
.msg {
  display: flex;
  margin-bottom: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  transition: background 0.3s ease;
}
.msg.user {
  background: #eef2ff;
  color: #312e81;
}
.msg.socrates {
  background: #f9fafb;
  color: #374151;
}
.msg.highlight {
  background: #fef3c7;
}
.msg-role {
  flex-shrink: 0;
  margin-right: 16rpx;
  font-weight: 600;
  color: #4f46e5;
}
.msg-content {
  flex: 1;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 海报占位 */
.poster-btn {
  margin-top: 8rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #4f46e5;
  font-size: 28rpx;
  border: 2rpx solid #c7d2fe;
}
.poster-btn::after { border: none; }

/* 海报弹层 */
.poster-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 999;
}

.poster-sheet {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx 60rpx;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-canvas {
  width: 620rpx;
  height: 900rpx;
  background: #eee;
  border-radius: 16rpx;
}

.poster-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  width: 100%;
}

.poster-save {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #4f46e5;
  color: #fff;
  font-size: 30rpx;
}
.poster-save::after { border: none; }

.poster-close {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #374151;
  font-size: 30rpx;
}
.poster-close::after { border: none; }
