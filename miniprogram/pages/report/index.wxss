/* 思辨报告 —— 星夜思辨 */

.page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, var(--night-1) 0%, var(--night-0) 100%);
}

.state-wrap {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-4);
}

.scaffold {
  position: relative;
  z-index: 1;
  height: 100%;
  padding: var(--sp-3) var(--sp-4) 0;
  box-sizing: border-box;
}

.share-hint {
  padding: var(--sp-2) var(--sp-3);
  margin-bottom: var(--sp-3);
  background: rgba(251, 191, 36, 0.08);
  border: 1rpx solid rgba(251, 191, 36, 0.3);
  border-radius: var(--r-md);
  font-size: var(--fs-caption);
  color: var(--star-amber);
  text-align: center;
  letter-spacing: 1rpx;
}

/* 玻璃卡通用 */
.glass-card {
  padding: var(--sp-4);
  margin-bottom: var(--sp-3);
}

.card-title {
  display: block;
  font-size: var(--fs-label);
  color: var(--text-3);
  letter-spacing: 4rpx;
  margin-bottom: var(--sp-2);
  margin-right: -4rpx;
  text-transform: uppercase;
}

/* === 评分环卡 === */
.score-card {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
}

.score-ring {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 0 24rpx rgba(157, 107, 255, 0.35));
}

.score-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.meta-item {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 8rpx 0;
  border-bottom: 1rpx solid rgba(157, 107, 255, 0.08);
}

.meta-item:last-child { border-bottom: none; }

.meta-label {
  font-size: var(--fs-caption);
  color: var(--text-3);
  letter-spacing: 2rpx;
}

.meta-value {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--star-purple);
}

/* === 雷达图 === */
.radar-card { text-align: center; }

.radar-canvas {
  width: 100%;
  height: 360rpx;
  margin: var(--sp-2) 0;
}

.radar-labels {
  display: flex;
  justify-content: center;
  gap: var(--sp-4);
  flex-wrap: wrap;
}

.rl-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--fs-caption);
  color: var(--text-2);
  letter-spacing: 1rpx;
}

.dot-k, .dot-d {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.dot-k { background: var(--star-cyan); box-shadow: 0 0 8rpx var(--star-cyan); }
.dot-d { background: var(--star-violet); box-shadow: 0 0 8rpx var(--star-violet); }

.degraded-tip {
  margin-top: var(--sp-1);
  font-size: var(--fs-caption);
  color: var(--star-amber);
  letter-spacing: 1rpx;
}

/* === 策略覆盖 === */
.strategy-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: 12rpx 0;
}

.strategy-label {
  width: 144rpx;
  flex-shrink: 0;
  font-size: var(--fs-label);
  color: var(--text-2);
  letter-spacing: 1rpx;
}

.strategy-track {
  flex: 1;
  height: 12rpx;
  background: rgba(157, 107, 255, 0.1);
  border-radius: var(--r-pill);
  overflow: hidden;
}

.strategy-bar {
  height: 100%;
  border-radius: var(--r-pill);
  transition: width 480ms ease;
}

.strategy-bar.on {
  background: linear-gradient(90deg, var(--star-purple), var(--star-violet));
  box-shadow: 0 0 8rpx var(--star-purple);
}

.strategy-bar.off { background: transparent; }

.strategy-mark {
  width: 48rpx;
  text-align: center;
  font-size: var(--fs-label);
  font-weight: 600;
}

.strategy-mark.on { color: var(--star-purple); }
.strategy-mark.off { color: var(--text-4); }

/* === 谬误 === */
.fallacy-item {
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid rgba(157, 107, 255, 0.1);
}

.fallacy-item:last-child { border-bottom: none; }

.item-hover { opacity: 0.7; }

.fallacy-type {
  display: inline-block;
  padding: 2rpx 16rpx;
  margin-right: 12rpx;
  border-radius: var(--r-pill);
  background: rgba(251, 113, 133, 0.15);
  color: var(--star-rose);
  font-size: var(--fs-caption);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.fallacy-quote {
  display: block;
  margin: 8rpx 0 4rpx;
  font-size: var(--fs-label);
  color: var(--text-1);
  line-height: 1.6;
}

.fallacy-round {
  font-size: var(--fs-caption);
  color: var(--text-3);
  letter-spacing: 1rpx;
}

/* === 高光原话 === */
.highlight-item {
  padding: var(--sp-2) 0;
  font-size: var(--fs-body);
  color: var(--text-1);
  border-bottom: 1rpx solid rgba(157, 107, 255, 0.1);
  line-height: 1.7;
}

.highlight-item:last-child { border-bottom: none; }

/* === 报告正文 === */
.report-text {
  display: block;
  font-size: var(--fs-body-lg);
  color: var(--text-1);
  line-height: 1.85;
  letter-spacing: 1rpx;
}

/* === 对话回溯 === */
.transcript-scroll {
  max-height: 800rpx;
  margin-top: var(--sp-1);
}

.msg-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(157, 107, 255, 0.08);
}

.msg-row:last-child { border-bottom: none; }

.msg-user .msg-content { color: var(--star-purple); }

.msg-role {
  display: block;
  font-size: var(--fs-caption);
  color: var(--text-3);
  margin-bottom: 4rpx;
  letter-spacing: 1rpx;
}

.msg-content {
  display: block;
  font-size: var(--fs-label);
  color: var(--text-1);
  line-height: 1.7;
}

.msg-row.highlight {
  background: rgba(157, 107, 255, 0.08);
  padding-left: 16rpx;
  border-left: 3rpx solid var(--star-purple);
  transition: all 240ms ease;
}

/* === 海报 === */
.poster-btn {
  width: 100%;
  margin: var(--sp-3) 0 var(--sp-2);
}

.bottom-spacer { height: 120rpx; }

.poster-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(12rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-sheet {
  width: 86%;
  max-width: 640rpx;
  background: var(--night-2);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--r-xl);
  padding: var(--sp-3);
  box-shadow: var(--shadow-float), var(--glow-purple);
}

.poster-canvas {
  width: 100%;
  height: 800rpx;
  border-radius: var(--r-lg);
}

.poster-actions {
  display: flex;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.poster-save { flex: 2; height: 80rpx; line-height: 80rpx; padding: 0; }
.poster-close { flex: 1; height: 80rpx; line-height: 80rpx; padding: 0; }
