<view class="page">
  <star-field />
  <scroll-view scroll-y class="scaffold">

  <view wx:if="{{loading}}" class="state-box">
    <empty-state mode="loading" />
  </view>

  <block wx:else>
    <!-- 段位卡片（含头像/昵称编辑入口） -->
    <view class="rank-card {{rankAnimClass}}">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{profile.avatar}}" class="avatar" src="{{profile.avatar}}" mode="aspectFill" />
        <view wx:else class="avatar-ph">头像</view>
      </button>
      <view class="rank-info">
        <input
          class="nick-input"
          type="nickname"
          placeholder="点击设置昵称"
          value="{{profile.nickName}}"
          bindinput="onNickNameInput"
          bindblur="onNickNameBlur"
        />
        <text class="rank-name">{{profile.rank || '新手'}}</text>
        <text class="rank-meta">累计 {{profile.totalRounds || 0}} 轮 · {{profile.totalSessions || 0}} 场</text>
      </view>
    </view>

    <!-- 统计卡片 -->
    <view class="stats-grid">
      <view class="stat-cell">
        <text class="stat-value">{{profile.totalSessions || 0}}</text>
        <text class="stat-label">完成场次</text>
      </view>
      <view class="stat-cell">
        <text class="stat-value">{{profile.totalRounds || 0}}</text>
        <text class="stat-label">累计轮次</text>
      </view>
      <view class="stat-cell">
        <text class="stat-value">{{profile.avgScore || 0}}</text>
        <text class="stat-label">平均得分</text>
      </view>
      <view class="stat-cell">
        <text class="stat-value">{{profile.winRate || 0}}%</text>
        <text class="stat-label">胜率</text>
      </view>
    </view>

    <!-- 今日配额分档（按段位） -->
    <view class="section-title">今日配额（按段位分档）</view>
    <view class="quota-list">
      <view class="quota-row">
        <text>单人思辨</text>
        <text class="quota-val">{{(profile.dailyLimit && profile.dailyLimit.L1) || 0}} 次/日</text>
      </view>
      <view class="quota-row">
        <text>双人共修</text>
        <text class="quota-val">{{(profile.dailyLimit && profile.dailyLimit.L2) || 0}} 次/日</text>
      </view>
      <view class="quota-row">
        <text>三方辩论</text>
        <text class="quota-val">{{(profile.dailyLimit && profile.dailyLimit.L3) || 0}} 次/日</text>
      </view>
      <view class="quota-row">
        <text>单日总轮次上限</text>
        <text class="quota-val">{{profile.maxRounds || 0}}</text>
      </view>
    </view>

    <!-- 功能入口 -->
    <view class="section-title">更多</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goHistory">
        <text class="menu-label">思辨历史</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goRanking">
        <text class="menu-label">段位排行</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="showPrivacy">
        <text class="menu-label">隐私说明</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="showAbout">
        <text class="menu-label">关于与合规</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="clearCache">
        <text class="menu-label">清空本地缓存</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="disclaimer">
      <text>AI 生成内容仅供参考，不构成专业建议</text>
      <text class="openid-line">账号标识：{{openid}}</text>
    </view>
  </block>

  <view class="bottom-spacer"></view>
  </scroll-view>
</view>
