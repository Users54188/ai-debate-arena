<view class="page">
  <star-field />

  <scroll-view scroll-y class="scaffold {{tabAnim}}" enhanced bounces show-scrollbar="{{false}}" deceleration-rate="0.98">
    <!-- 段位卡：头像 + 昵称 + 段位 + 累计 -->
    <view class="rank-card glass-card">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image class="avatar" src="{{profile.avatarUrl || '/images/app-icon-new.png'}}" mode="aspectFill" />
      </button>
      <view class="rank-info">
        <input class="nickname-input" type="nickname" value="{{profile.nickName}}" placeholder="点击设置昵称" bindblur="onNicknameBlur" />
        <text class="rank-name">{{profile.rank || '新手'}}</text>
        <text class="rank-meta">累计 {{profile.totalRounds || 0}} 轮 · 最佳 {{profile.bestScore || 0}} 分</text>
      </view>
    </view>

    <!-- 今日配额 -->
    <view class="quota-card glass-card">
      <view class="quota-head">
        <text class="quota-title">今日剩余配额</text>
        <text class="quota-reset">每日 0 点重置</text>
      </view>
      <view class="quota-list">
        <view class="quota-item">
          <text class="quota-label">L1 追问</text>
          <view class="quota-bar-wrap">
            <view class="quota-bar quota-bar-l1" style="width: {{quota.L1Percent}}%"></view>
          </view>
          <text class="quota-num">{{quota.L1Left}}/{{quota.L1Total}}</text>
        </view>
        <view class="quota-item">
          <text class="quota-label">L2 共修</text>
          <view class="quota-bar-wrap">
            <view class="quota-bar quota-bar-l2" style="width: {{quota.L2Percent}}%"></view>
          </view>
          <text class="quota-num">{{quota.L2Left}}/{{quota.L2Total}}</text>
        </view>
        <view class="quota-item">
          <text class="quota-label">L3 辩论</text>
          <view class="quota-bar-wrap">
            <view class="quota-bar quota-bar-l3" style="width: {{quota.L3Percent}}%"></view>
          </view>
          <text class="quota-num">{{quota.L3Left}}/{{quota.L3Total}}</text>
        </view>
      </view>
    </view>

    <!-- 功能入口 -->
    <view class="menu glass-card">
      <view class="menu-item" bindtap="goHistory" hover-class="menu-hover">
        <text class="menu-icon">📜</text>
        <text class="menu-label">思辨历史</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goRanking" hover-class="menu-hover">
        <text class="menu-icon">🏆</text>
        <text class="menu-label">段位排行</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="toggleSettings" hover-class="menu-hover">
        <text class="menu-icon">⚙️</text>
        <text class="menu-label">设置</text>
        <text class="menu-arrow">{{showSettings ? '▾' : '›'}}</text>
      </view>
      <view wx:if="{{showSettings}}" class="settings-panel">
        <view class="setting-row">
          <text class="setting-label">触感反馈</text>
          <switch checked="{{haptics}}" bindchange="onHapticsChange" color="#9D6BFF" />
        </view>
        <view class="setting-row">
          <text class="setting-label">减少动画</text>
          <switch checked="{{reduceMotion}}" bindchange="onReduceMotionChange" color="#9D6BFF" />
        </view>
      </view>
      <view class="menu-item" bindtap="showUserAgreement" hover-class="menu-hover">
        <text class="menu-icon">📜</text>
        <text class="menu-label">用户协议</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="showPrivacy" hover-class="menu-hover">
        <text class="menu-icon">🔒</text>
        <text class="menu-label">隐私协议</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="showAbout" hover-class="menu-hover">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-label">关于思辨场</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="footnote">
      <text class="footnote-dot">·</text>
      <text class="footnote-text">AI 生成内容仅供参考</text>
      <text class="footnote-dot">·</text>
    </view>
    <view class="bottom-spacer"></view>
  </scroll-view>
</view>
