.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 16px;
  box-sizing: border-box;
}

.state-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 140px;
}

.state-text {
  font-size: 15px;
  color: var(--text-secondary);
}

/* 段位卡 */
.rank-card {
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  border-radius: 16px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
  margin-bottom: 14px;
}

.rank-avatar {
  width: 64px;
  height: 64px;
  border-radius: 32px;
  border: 2px solid rgba(255, 255, 255, 0.6);
  margin-bottom: 10px;
}

.rank-name {
  font-size: 22px;
  font-weight: 700;
}

.rank-next {
  font-size: 12px;
  opacity: 0.85;
  margin-top: 4px;
}

.rank-progress {
  width: 100%;
  height: 8px;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4px;
  margin-top: 14px;
  overflow: hidden;
}

.rank-progress-bar {
  height: 100%;
  background: #fbbf24;
  border-radius: 4px;
}

/* 统计 */
.stats-grid {
  display: flex;
  background: var(--bg-card);
  border-radius: 14px;
  padding: 16px 8px;
  margin-bottom: 14px;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 20px;
  font-weight: 700;
  color: var(--text-primary);
}

.stat-label {
  font-size: 11px;
  color: var(--text-tertiary);
  margin-top: 4px;
}

/* 菜单 */
.menu-list {
  background: var(--bg-card);
  border-radius: 14px;
  overflow: hidden;
  margin-bottom: 14px;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 16px;
  border-bottom: 1px solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 15px;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 18px;
  color: var(--text-tertiary);
}

/* 合规说明 */
.disclaimer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  margin-top: 8px;
}

.disclaimer text {
  font-size: 11px;
  color: var(--text-tertiary);
}

/* 头像按钮与昵称输入（接 chooseAvatar / nickname input） */
.rank-card {
 flex-direction: row;
 align-items: center;
 text-align: left;
}

.avatar-btn {
 width: 64px;
 height: 64px;
 padding: 0;
 margin: 0;
 border-radius: 50%;
 background: rgba(255, 255, 255, 0.2);
 display: flex;
 align-items: center;
 justify-content: center;
 line-height: 1;
 flex-shrink: 0;
}

.avatar-btn::after { border: none; }

.avatar {
 width: 64px;
 height: 64px;
 border-radius: 50%;
}

.avatar-ph {
 font-size: 13px;
 color: #fff;
}

.rank-info {
 margin-left: 14px;
 flex: 1;
 display: flex;
 flex-direction: column;
 gap: 4px;
}

.nick-input {
 font-size: 16px;
 font-weight: 600;
 color: #fff;
 background: transparent;
 border-bottom: 1px solid rgba(255, 255, 255, 0.3);
 padding-bottom: 4px;
 margin-bottom: 2px;
}

.rank-meta {
 font-size: 12px;
 opacity: 0.85;
}

/* 配额分档区 */
.section-title {
 font-size: 13px;
 color: var(--text-tertiary);
 padding: 8px 4px;
}

.quota-list {
 background: var(--bg-card);
 border-radius: 14px;
 padding: 4px 16px;
 margin-bottom: 14px;
}

.quota-row {
 display: flex;
 justify-content: space-between;
 padding: 12px 0;
 border-bottom: 1px solid var(--border);
 font-size: 14px;
}

.quota-row:last-child { border-bottom: none; }

.quota-val {
 color: var(--primary, #4F46E5);
 font-weight: 600;
}

.openid-line {
 font-size: 10px;
 opacity: 0.6;
 margin-top: 4px;
 max-width: 240px;
 overflow: hidden;
 text-overflow: ellipsis;
 white-space: nowrap;
}

/* 段位升级动效 */
.rank-up-anim {
 animation: rank-up 1.6s ease-out;
}

@keyframes rank-up {
 0% { transform: scale(1); box-shadow: 0 0 0 rgba(124, 58, 237, 0); }
 20% { transform: scale(1.04); box-shadow: 0 0 24px rgba(251, 191, 36, 0.6); }
 100% { transform: scale(1); box-shadow: 0 0 0 rgba(124, 58, 237, 0); }
}