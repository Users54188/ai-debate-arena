.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 16px;
  box-sizing: border-box;
}

.state-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 140px;
}

.state-text {
  font-size: 15px;
  color: var(--text-secondary);
}

/* 段位卡 */
.rank-card {
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  border-radius: 16px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
  margin-bottom: 14px;
}

.rank-avatar {
  width: 64px;
  height: 64px;
  border-radius: 32px;
  border: 2px solid rgba(255, 255, 255, 0.6);
  margin-bottom: 10px;
}

.rank-name {
  font-size: 22px;
  font-weight: 700;
}

.rank-next {
  font-size: 12px;
  opacity: 0.85;
  margin-top: 4px;
}

.rank-progress {
  width: 100%;
  height: 8px;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4px;
  margin-top: 14px;
  overflow: hidden;
}

.rank-progress-bar {
  height: 100%;
  background: #fbbf24;
  border-radius: 4px;
}

/* 统计 */
.stats-grid {
  display: flex;
  background: var(--bg-card);
  border-radius: 14px;
  padding: 16px 8px;
  margin-bottom: 14px;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 20px;
  font-weight: 700;
  color: var(--text-primary);
}

.stat-label {
  font-size: 11px;
  color: var(--text-tertiary);
  margin-top: 4px;
}

/* 菜单 */
.menu-list {
  background: var(--bg-card);
  border-radius: 14px;
  overflow: hidden;
  margin-bottom: 14px;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 16px;
  border-bottom: 1px solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 15px;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 18px;
  color: var(--text-tertiary);
}

/* 合规说明 */
.disclaimer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  margin-top: 8px;
}

.disclaimer text {
  font-size: 11px;
  color: var(--text-tertiary);
}