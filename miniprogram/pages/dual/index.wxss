.dual-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page, #F5F3FF);
}

chat-stream {
  flex: 1;
  overflow: hidden;
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: var(--bg-card, #FFFFFF);
  border-top: 1px solid var(--border, #E0E7FF);
}

.msg-input {
  flex: 1;
  height: 36px;
  background: var(--bg-page, #F5F3FF);
  border-radius: var(--radius-sm, 8px);
  padding: 0 12px;
  font-size: 14px;
}

.send-btn {
  flex-shrink: 0;
  background: var(--primary, #4F46E5);
  color: white;
  font-size: 13px;
  border-radius: var(--radius-sm, 8px);
  padding: 0 16px;
  height: 36px;
  line-height: 36px;
  border: none;
}

.send-btn[disabled] {
  background: var(--border, #E0E7FF);
  color: var(--text-secondary, #6B7280);
}

.quota-notice,
.round-limit-notice {
  padding: 10px 16px;
  text-align: center;
  font-size: 13px;
  color: var(--warning, #F59E0B);
  background: #FFFBEB;
}