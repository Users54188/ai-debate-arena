<view class="page">
  <star-field />

  <!-- 临时诊断浮层：排查 L1 卡 2 轮问题。修复后删除 -->
  <view class="debug-panel" wx:if="{{debugLogs.length}}">
    <view class="debug-header">
      <text>诊断日志 ({{debugLogs.length}})</text>
      <text class="debug-clear" bindtap="onDebugClear">清空</text>
    </view>
    <scroll-view scroll-y class="debug-list" scroll-into-view="dbg-{{debugLogs.length - 1}}">
      <view
        wx:for="{{debugLogs}}"
        wx:key="index"
        id="dbg-{{index}}"
        class="debug-line dbg-{{item.level}}"
      >{{item.msg}}</view>
    </scroll-view>
  </view>

  <view class="body">
    <chat-stream
      id="chat"
      messages="{{messages}}"
      streaming="{{streaming}}"
      waitingFirstChunk="{{waitingFirstChunk}}"
      waitingText="苏格拉底正在思考"
      showAiLabel="{{true}}"
    />
  </view>

  <view class="dock safe-bottom">
    <view class="dock-inner">
      <input
        class="dock-input"
        value="{{inputText}}"
        bindinput="onInput"
        bindconfirm="sendMessage"
        placeholder="说出你的观点…"
        placeholder-class="ph"
        confirm-type="send"
        confirm-hold="true"
        hold-keyboard="true"
        adjust-position="{{true}}"
        cursor-spacing="28"
        disabled="{{streaming || quotaExhausted}}"
      />
      <button
        class="dock-send"
        bindtap="sendMessage"
        disabled="{{inputText.length === 0 || streaming || quotaExhausted}}"
        size="mini"
        hover-class="btn-hover"
      >发送</button>
    </view>

    <view wx:if="{{quotaExhausted}}" class="notice">
      今日 L1 会话次数已用完，明日再会
    </view>
    <!-- 多重判定之一：AI 认为思辨已充分（软信号，可继续追问也可结束） -->
    <view wx:if="{{aiEndSuggested && !roundLimitReached && !streaming}}" class="ai-end-tip">
      <text class="ai-end-text">苏格拉底认为这次思辨已经比较充分</text>
      <button class="ai-end-btn" bindtap="promptReport" size="mini" hover-class="btn-hover">结束并查看报告</button>
    </view>
    <!-- 多重判定之二：用户随时可主动结束 -->
    <view wx:if="{{!roundLimitReached && !streaming && messages.length > 0}}" class="manual-end">
      <text class="manual-end-link" bindtap="onManualEnd">结束本次思辨</text>
    </view>
    <view wx:if="{{roundLimitReached}}" class="notice notice-round">
      本次思辨已结束，可查看思辨报告
    </view>
  </view>
</view>
