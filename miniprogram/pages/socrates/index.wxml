<view class="socrates-page">
  <!-- 加载动画 -->
  <view wx:if="{{loading}}" class="loading-overlay">
    <video
      class="loading-video"
      src="/images/socrates-loading.mp4"
      autoplay
      loop
      muted
      show-center-play-btn="{{false}}"
      show-fullscreen-btn="{{false}}"
      show-play-btn="{{false}}"
      controls="{{false}}"
    />
    <text class="loading-text">苏格拉底正在思考...</text>
  </view>

  <!-- 背景图 -->
  <image class="bg-image" src="/images/bg-tarot.png" mode="aspectFill" />

  <!-- chat-stream 对话区 -->
  <chat-stream
    messages="{{messages}}"
    streaming="{{streaming}}"
    waitingFirstChunk="{{waitingFirstChunk}}"
    showAiLabel="{{true}}"
  />

  <!-- 底部输入区 -->
  <view class="input-bar safe-bottom">
    <input
      class="msg-input"
      value="{{inputText}}"
      bindinput="onInput"
      bindconfirm="sendMessage"
      placeholder="说出你的观点，苏格拉底会追问你..."
      confirm-type="send"
      disabled="{{loading || streaming || quotaExhausted}}"
      adjust-position="{{true}}"
      cursor-spacing="{{12}}"
    />
    <button
      class="send-btn"
      bindtap="sendMessage"
      disabled="{{!inputText.trim() || loading || streaming || quotaExhausted}}"
      size="mini"
    >
      发送
    </button>
  </view>

  <!-- 配额用尽提示 -->
  <view wx:if="{{quotaExhausted}}" class="quota-notice">
    <text>今日 L1 会话次数已用完，明天再来思辨吧</text>
  </view>

  <!-- 轮次上限提示 -->
  <view wx:if="{{roundLimitReached}}" class="round-limit-notice">
    <text>已达 10 轮上限，可查看思辨报告</text>
  </view>
</view>
