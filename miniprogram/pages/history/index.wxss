/* 思辨历史页 —— 星夜思辨 */

.page {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: linear-gradient(180deg, var(--night-1) 0%, var(--night-0) 100%);
}

.state-box {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--sp-4);
}

.list {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
}

.list-inner {
  padding: var(--sp-3) var(--sp-4) var(--sp-5);
}

/* === 会话卡 === */
.session-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-3) var(--sp-4);
  margin-bottom: var(--sp-2);
  transition: transform 120ms ease, border-color 200ms ease;
}

.card-hover {
  transform: scale(0.98);
  border-color: var(--glass-border-strong) !important;
}

.card-left {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  flex: 1;
  min-width: 0;
}

.mode-tag {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-label);
  font-weight: 700;
  color: #FFFFFF;
  flex-shrink: 0;
  letter-spacing: 0;
}

.tag-l1 { background: linear-gradient(135deg, var(--star-indigo), #4338CA); box-shadow: 0 0 16rpx rgba(99, 102, 241, 0.4); }
.tag-l2 { background: linear-gradient(135deg, #06B6D4, #0E7490); box-shadow: 0 0 16rpx rgba(103, 232, 249, 0.4); }
.tag-l3 { background: linear-gradient(135deg, var(--star-violet), #9333EA); box-shadow: 0 0 16rpx rgba(192, 132, 252, 0.4); }

.card-body {
  flex: 1;
  min-width: 0;
}

.card-title {
  display: block;
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--text-1);
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-meta {
  display: block;
  font-size: var(--fs-caption);
  color: var(--text-3);
  letter-spacing: 1rpx;
}

.card-right {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  flex-shrink: 0;
}

.card-time {
  font-size: var(--fs-caption);
  color: var(--text-4);
}

.card-arrow {
  font-size: var(--fs-body);
  color: var(--star-purple);
}

.tip {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: var(--sp-2) var(--sp-3);
  font-size: var(--fs-caption);
  color: var(--text-4);
  letter-spacing: 1rpx;
}
