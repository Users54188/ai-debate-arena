<view class="page">
  <star-field />

  <!-- 加载骨架：复用与真实列表完全相同的容器/内边距，保证布局一致、顶部对齐 -->
  <scroll-view wx:if="{{loading}}" scroll-y class="list {{tabAnim}}" enhanced bounces show-scrollbar="{{false}}">
    <view class="list-inner">
      <empty-state mode="loading" skeleton="list" />
    </view>
  </scroll-view>

  <view wx:elif="{{loadError}}" class="state-box {{tabAnim}}">
    <empty-state mode="error" title="{{loadError}}" cta="重新加载" bind:tap="loadHistory" />
  </view>

  <view wx:elif="{{empty}}" class="state-box {{tabAnim}}">
    <empty-state
      mode="empty"
      title="还没有思辨记录"
      desc="去首页完成一场思辨，报告会在这里沉淀"
      cta="开始第一场"
      bind:tap="goHome"
    />
  </view>

  <scroll-view wx:else class="list {{tabAnim}}" scroll-y enhanced bounces show-scrollbar="{{false}}" deceleration-rate="0.98">
    <view class="list-inner">
    <view
      class="session-card glass-card stagger-item"
      wx:for="{{sessions}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goReport"
      bindlongpress="onDelete"
      hover-class="card-hover"
      hover-stay-time="80"
      style="--i: {{index}}"
    >
      <view class="card-left">
        <view class="mode-tag tag-{{item.modeClass}}">{{item.mode}}</view>
        <view class="card-body">
          <text class="card-title">{{item.topic}}</text>
          <text class="card-meta">{{item.modeLabel}} · {{item.roundsLabel}}</text>
        </view>
      </view>
      <view class="card-right">
        <text class="card-time">{{item.createdAt}}</text>
        <text class="card-arrow">›</text>
      </view>
    </view>
    </view>
  </scroll-view>

  <view class="tip safe-bottom">
    <text>长按会话卡可删除历史记录</text>
  </view>
</view>