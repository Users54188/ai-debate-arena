<view class="page">
  <star-field />

  <view wx:if="{{loading}}" class="state-box">
    <empty-state mode="loading" />
  </view>

  <view wx:elif="{{empty}}" class="state-box">
    <empty-state
      mode="empty"
      title="还没有思辨记录"
      desc="去首页完成一场思辨，报告会在这里沉淀"
      cta="开始第一场"
      bind:tap="goHome"
    />
  </view>

  <scroll-view wx:else class="list" scroll-y>
    <view class="list-inner">
    <view
      class="session-card glass-card"
      wx:for="{{sessions}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goReport"
      bindlongpress="onDelete"
      hover-class="card-hover"
      hover-stay-time="80"
    >
      <view class="card-left">
        <view class="mode-tag tag-{{item.modeClass}}">{{item.mode}}</view>
        <view class="card-body">
          <text class="card-title">{{item.topic}}</text>
          <text class="card-meta">{{item.modeLabel}} · {{item.roundsLabel}}</text>
        </view>
      </view>
      <view class="card-right">
        <text class="card-time">{{item.createdAt}}</text>
        <text class="card-arrow">›</text>
      </view>
    </view>
    </view>
  </scroll-view>

  <view class="tip safe-bottom">
    <text>长按会话卡可删除历史记录</text>
  </view>
</view>