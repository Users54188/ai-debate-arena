/* ============================================================
 * 思辨场 — 星夜思辨·紫调 全局设计系统
 *
 * 调性：深邃星空 + 紫罗兰光晕 + 玻璃态层级
 * 严禁散落硬编码颜色，所有视觉值统一在此维护。
 * ============================================================ */

page {
  /* —— 夜空层级 —— */
  --night-0: #07041F;          /* 最深（页面底色） */
  --night-1: #0E0830;          /* 主背景 */
  --night-2: #181142;          /* 次背景（卡片玻璃态） */
  --night-3: #251A5C;          /* 高亮卡片 */
  --night-4: #332574;          /* 选中/按下态 */

  /* —— 星辰强调色 —— */
  --star-purple: #9D6BFF;      /* 主强调（按钮/链接/重点） */
  --star-purple-soft: #B58BFF; /* 悬浮态 */
  --star-indigo: #6366F1;      /* 副强调（L1 苏格拉底） */
  --star-violet: #C084FC;      /* 柔光（L3 正方） */
  --star-amber: #FBBF24;       /* 星辰金（得分/段位点缀） */
  --star-cyan: #67E8F9;        /* 冷光点缀 */
  --star-rose: #FB7185;        /* 警告/反方 */

  /* —— 文字层级 —— */
  --text-1: #F5F3FF;           /* 主标题/正文 */
  --text-2: #C7CFF0;           /* 副文本 */
  --text-3: #8B86C7;           /* 弱化说明 */
  --text-4: #5C5688;           /* 极弱（占位/分割） */

  /* —— 玻璃态 —— */
  --glass-bg: rgba(255, 255, 255, 0.045);
  --glass-bg-strong: rgba(255, 255, 255, 0.075);
  --glass-border: rgba(157, 107, 255, 0.22);
  --glass-border-strong: rgba(157, 107, 255, 0.45);
  --glass-highlight: rgba(255, 255, 255, 0.08);

  /* —— 角色色（对话气泡 / 头像） —— */
  --role-socrates: #6366F1;    /* L1 苏格拉底 - 靛蓝 */
  --role-expert: #67E8F9;      /* L2 专家 - 冷光 */
  --role-affirmative: #C084FC; /* L3 正方 - 柔紫 */
  --role-negative: #FB7185;    /* L3 反方 - 玫红 */
  --role-judge: #FBBF24;       /* L3 裁判 - 星辰金 */
  --role-user: #9D6BFF;        /* 用户 - 主紫 */

  /* —— 圆角 —— */
  --r-sm: 8rpx;
  --r-md: 16rpx;
  --r-lg: 24rpx;
  --r-xl: 32rpx;
  --r-pill: 999rpx;

  /* —— 间距 —— */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;
  --sp-5: 48rpx;
  --sp-6: 64rpx;

  /* —— iOS 标准动效系统（2026-09-05 UI 优化） —— */
  /* 时长（苹果自定义曲线对应的最舒适时长） */
  --dur-instant: 100ms;   /* 按下/释放即时反馈 */
  --dur-fast: 180ms;      /* 小元素状态切换 */
  --dur-base: 280ms;      /* 默认过渡（卡片、按钮） */
  --dur-slow: 420ms;      /* 大区块进入/退出 */
  /* 缓动（苹果系统曲线） */
  --ease-out: cubic-bezier(0.32, 0.72, 0, 1);      /* 默认出场：快进慢出 */
  --ease-in: cubic-bezier(0.4, 0, 1, 1);           /* 收回：慢进快出 */
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);     /* 双向 */
  --ease-spring: cubic-bezier(0.5, 1.6, 0.4, 1);   /* 弹簧（按下反馈） */
  /* 触摸反馈 token */
  --press-scale: 0.97;   /* 按下缩放比（iOS 标准） */
  --press-opacity: 0.88; /* 按下透明度 */

  /* —— 阴影 / 光晕 —— */
  --shadow-card: 0 8rpx 32rpx rgba(0, 0, 0, 0.32);
  --shadow-float: 0 16rpx 48rpx rgba(0, 0, 0, 0.4);
  --glow-purple: 0 0 24rpx rgba(157, 107, 255, 0.35);
  --glow-soft: 0 0 40rpx rgba(157, 107, 255, 0.18);

  /* —— 字体 —— */
  --fs-caption: 22rpx;
  --fs-label: 24rpx;
  --fs-body: 28rpx;
  --fs-body-lg: 30rpx;
  --fs-title: 34rpx;
  --fs-h2: 40rpx;
  --fs-h1: 48rpx;

  background-color: var(--night-0);
  color: var(--text-1);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC", "Helvetica Neue", sans-serif;
  font-size: var(--fs-body);
  line-height: 1.7;
}

/* ============================================================
 * 通用工具类
 * ============================================================ */

/* 玻璃态卡片 —— 全应用统一容器样式
 * P0 性能优化（2026-09-05）：移除 backdrop-filter: blur(20rpx) —— 多卡片同时 blur
 * 会持续吃 GPU 合成预算导致滚动卡顿。改成纯色半透明（视觉接近 + 零合成开销）。 */
.glass-card {
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
}

.glass-card-strong {
  background: var(--glass-bg-strong);
  border: 1rpx solid var(--glass-border-strong);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card), var(--glow-soft);
}

/* 主按钮 —— 紫光填充 */
.btn-primary {
  background: linear-gradient(135deg, var(--star-purple) 0%, var(--star-indigo) 100%);
  color: var(--text-1);
  border-radius: var(--r-pill);
  font-size: var(--fs-body-lg);
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: var(--glow-purple);
  border: none;
  height: 96rpx;
  line-height: 96rpx;
  transition: transform var(--dur-instant) var(--ease-spring),
              opacity var(--dur-instant) var(--ease-out),
              box-shadow var(--dur-fast) var(--ease-out);
}
.btn-primary[disabled] {
  background: var(--night-3);
  color: var(--text-3);
  box-shadow: none;
}
/* iOS 标准触摸反馈：按下 0.97 缩放 + 透明度，100ms 内反馈 */
.btn-primary:active:not([disabled]) {
  transform: scale(var(--press-scale));
  opacity: var(--press-opacity);
  box-shadow: 0 0 12rpx rgba(157, 107, 255, 0.5);
}

/* 次按钮 —— 玻璃描边 */
.btn-ghost {
  background: var(--glass-bg);
  color: var(--text-1);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--r-pill);
  font-size: var(--fs-body);
  height: 88rpx;
  line-height: 88rpx;
  transition: transform var(--dur-instant) var(--ease-spring),
              opacity var(--dur-instant) var(--ease-out);
}
.btn-ghost:active {
  transform: scale(var(--press-scale));
  opacity: var(--press-opacity);
}

/* 角色徽章 */
.role-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-label);
  font-weight: 500;
  letter-spacing: 1rpx;
  background: var(--glass-bg);
  border: 1rpx solid var(--glass-border);
}

/* 排版 */
.h1 { font-size: var(--fs-h1); font-weight: 700; letter-spacing: 2rpx; color: var(--text-1); }
.h2 { font-size: var(--fs-h2); font-weight: 600; letter-spacing: 1rpx; color: var(--text-1); }
.title { font-size: var(--fs-title); font-weight: 600; color: var(--text-1); }
.body { font-size: var(--fs-body); color: var(--text-2); line-height: 1.75; }
.caption { font-size: var(--fs-caption); color: var(--text-3); }
.label { font-size: var(--fs-label); color: var(--text-3); letter-spacing: 1rpx; }

/* 安全区域 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 渐隐分割线 */
.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--glass-border), transparent);
}

/* 浮动星点装饰（角落点缀） */
.star-dot {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: var(--text-1);
  box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.8);
  opacity: 0.6;
  pointer-events: none;
}

/* ============================================================
 * 页面/tab 切换过渡 —— iOS 风 280ms 淡入 + 小幅上移
 * （2026-09-05）：tabBar 切换本身是系统动画，开发者无法控制；
 * 这里给页面主体加进入动画，让用户感知"页面是从下方滑入"而非"硬切"
 * 使用 GPU 加速的 transform + opacity，零重排
 * ============================================================ */
.page-enter {
  animation: page-enter-anim var(--dur-base, 280ms) var(--ease-out, cubic-bezier(0.32, 0.72, 0, 1)) both;
  will-change: transform, opacity;
}

@keyframes page-enter-anim {
  0%   { opacity: 0; transform: translateY(16rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

/* ============================================================
 * tabBar 方向感知切换（2026-09-05 iOS 化）
 * switchTab 是系统级瞬时切换、无动画，故由各 tab 页在 onShow 时
 * 重新挂载下列类来重放：向右切 tab 从右侧轻滑入，向左切从左侧入。
 * 全程 translate3d 走 GPU 合成层，只动 transform/opacity，零重排。
 * ============================================================ */
.tab-enter {
  will-change: transform, opacity;
  backface-visibility: hidden;
}
/* 重挂动画的过渡帧：先隐藏，避免"清空类→重加类"之间闪现一帧全亮画面 */
.tab-enter--reset { opacity: 0; }
.tab-enter--next { animation: tab-in-right 300ms var(--ease-out, cubic-bezier(0.32, 0.72, 0, 1)) both; }
.tab-enter--prev { animation: tab-in-left 300ms var(--ease-out, cubic-bezier(0.32, 0.72, 0, 1)) both; }
.tab-enter--idle { animation: page-enter-anim var(--dur-base, 280ms) var(--ease-out, cubic-bezier(0.32, 0.72, 0, 1)) both; }

@keyframes tab-in-right {
  from { opacity: 0; transform: translate3d(48rpx, 0, 0); }
  to   { opacity: 1; transform: translate3d(0, 0, 0); }
}
@keyframes tab-in-left {
  from { opacity: 0; transform: translate3d(-48rpx, 0, 0); }
  to   { opacity: 1; transform: translate3d(0, 0, 0); }
}

/* 骨架屏 → 真实内容 的柔和交接：首次加载数据回来时内容轻轻上浮淡入，
 * 不再重复一次侧向滑动，避免"骨架硬切 + 内容再滑一遍"的僵硬感 */
.content-reveal {
  animation: content-reveal-anim 300ms var(--ease-out, cubic-bezier(0.32, 0.72, 0, 1)) both;
  will-change: transform, opacity;
}
@keyframes content-reveal-anim {
  from { opacity: 0; transform: translate3d(0, 14rpx, 0); }
  to   { opacity: 1; transform: translate3d(0, 0, 0); }
}

/* 尊重系统"减弱动态效果"：直接落到终态，避免眩晕 */
@media (prefers-reduced-motion: reduce) {
  .tab-enter--reset { opacity: 1 !important; }
  .page-enter,
  .tab-enter--next,
  .tab-enter--prev,
  .tab-enter--idle,
  .content-reveal,
  .stagger-item { animation-duration: 1ms !important; }
}

/* 单个 staggered 项 —— 按索引自我延时
 * 用法：子项加 class="stagger-item" style="--i: {{index}}"
 * （WXSS 不支持选择器列表里的 `*`，所以不使用 .parent > * 模式） */
.stagger-item {
  animation: page-enter-anim var(--dur-base, 280ms) var(--ease-out, cubic-bezier(0.32, 0.72, 0, 1)) both;
  animation-delay: calc(var(--i, 0) * 40ms);
}

/* 限制 stagger 总延时不超过 600ms（最多 15 项可见内可见延时） */
.stagger-item:nth-child(n + 16) {
  animation-delay: 0ms;
}
