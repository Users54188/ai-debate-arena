<view class="dual-page">
  <chat-stream
    messages="{{messages}}"
    streaming="{{streaming}}"
    waitingFirstChunk="{{waitingFirstChunk}}"
    waitingText="{{phase === 'expert' ? '专家正在讲解…' : '苏格拉底正在思考…'}}"
    showAiLabel="{{true}}"
  />

  <view class="input-bar safe-bottom">
    <input
      class="msg-input"
      value="{{inputText}}"
      bindinput="onInput"
      bindconfirm="sendMessage"
      placeholder="说出你的话题，专家会为你讲解…"
      confirm-type="send"
      disabled="{{streaming || quotaExhausted}}"
      adjust-position="{{true}}"
      cursor-spacing="{{12}}"
    />
    <button
      class="send-btn"
      bindtap="sendMessage"
      disabled="{{!inputText.trim() || streaming || quotaExhausted}}"
      size="mini"
    >发送</button>
  </view>

  <view wx:if="{{quotaExhausted}}" class="quota-notice">
    <text>今日 L2 共修次数已用完，明天再来吧</text>
  </view>

  <view wx:if="{{roundLimitReached}}" class="round-limit-notice">
    <text>已达 6 轮上限，可查看思辨报告</text>
  </view>
</view>