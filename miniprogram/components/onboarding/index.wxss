.onboarding-mask {
  position: fixed;
  inset: 0;
  background: #000;
  z-index: 9999;
  display: flex;
  flex-direction: column;
}

.onboarding-swiper {
  flex: 1;
  width: 100%;
}

.slide {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  box-sizing: border-box;
  color: #fff;
  text-align: center;
}

.slide-emoji {
  font-size: 160rpx;
  margin-bottom: 60rpx;
}

.slide-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
  letter-spacing: 2rpx;
}

.slide-desc {
  font-size: 30rpx;
  line-height: 1.7;
  opacity: 0.9;
  max-width: 560rpx;
}

.onboarding-dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx 0 16rpx;
  background: #000;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.25);
  transition: all 0.25s;
}

.dot-active {
  width: 48rpx;
  background: #fff;
}

.onboarding-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 40rpx 50rpx;
  background: #000;
}

.skip-btn {
  color: rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
  padding: 12rpx 24rpx;
}

.next-btn {
  background: #fff;
  color: #4F46E5;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 18rpx 60rpx;
  line-height: 1;
}

.next-btn::after {
  border: none;
}
