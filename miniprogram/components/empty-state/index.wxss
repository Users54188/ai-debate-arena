/* empty-state —— 夜空适配 */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.9;
  filter: drop-shadow(0 0 24rpx rgba(157, 107, 255, 0.4));
}

.empty-title {
  font-size: var(--fs-body-lg, 30rpx);
  color: var(--text-2, #C7CFF0);
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.empty-desc {
  font-size: var(--fs-label, 26rpx);
  color: var(--text-3, #8B86C7);
  line-height: 1.7;
  max-width: 480rpx;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.empty-cta {
  margin-top: 16rpx;
  background: linear-gradient(135deg, var(--star-purple, #9D6BFF), var(--star-indigo, #6366F1));
  color: #FFFFFF;
  font-size: var(--fs-label, 26rpx);
  border-radius: 999rpx;
  padding: 14rpx 48rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
  box-shadow: 0 0 24rpx rgba(157, 107, 255, 0.4);
  border: none;
}

.empty-cta::after {
  border: none;
}
