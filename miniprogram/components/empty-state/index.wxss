.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.7;
}

.empty-title {
  font-size: 30rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9ca3af;
  line-height: 1.6;
  max-width: 480rpx;
  margin-bottom: 24rpx;
}

.empty-cta {
  margin-top: 16rpx;
  background: #4F46E5;
  color: #fff;
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 12rpx 48rpx;
  line-height: 1.4;
}

.empty-cta::after {
  border: none;
}
