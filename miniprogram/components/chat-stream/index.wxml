<scroll-view
  id="chat-scroll-view"
  scroll-y
  scroll-top="{{scrollTop}}"
  scroll-with-animation
  class="chat-container"
>
  <view wx:for="{{renderMessages}}" wx:key="index" class="message-row {{item.isUser ? 'msg-right' : 'msg-left'}}">
    <!-- 角色标签 -->
    <text wx:if="{{!item.isUser}}" class="role-label">{{item.roleText}}</text>
    <!-- 气泡 -->
    <view class="bubble {{item.bubbleCls}}">
      <text class="bubble-text">{{item.content}}</text>
      <!-- 混元 note 保留（合规：不删除模型 note 字段，常驻展示） -->
      <text wx:if="{{item.note}}" class="bubble-note">{{item.note}}</text>
    </view>
  </view>

  <!-- 首帧未到达时的占位态 -->
  <view wx:if="{{streaming && waitingFirstChunk}}" class="message-row msg-left">
    <text class="role-label">{{waitingText}}</text>
    <view class="bubble bubble-streaming">
      <view class="typing-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>
  </view>

  <!-- AI 生成标识 -->
  <view wx:if="{{showAiLabel && renderMessages.length > 0}}" class="ai-label">
    <text>以上内容为AI生成，仅供参考</text>
  </view>

  <view id="chat-bottom-anchor"></view>
</scroll-view>
