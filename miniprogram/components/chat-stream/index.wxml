<scroll-view
  id="chat-scroll-view"
  scroll-y
  scroll-top="{{scrollTop}}"
  scroll-with-animation
  class="chat-container"
>
  <view wx:for="{{messages}}" wx:key="index" class="message-row {{item.role === 'user' ? 'msg-right' : 'msg-left'}}">
    <!-- 角色标签 -->
    <text wx:if="{{item.role !== 'user'}}" class="role-label">{{roleLabel(item.role)}}</text>
    <!-- 气泡 -->
    <view class="bubble {{bubbleClass(item.role)}}">
      <text class="bubble-text">{{item.content}}</text>
    </view>
  </view>

  <!-- 流式输入中占位态 -->
  <view wx:if="{{streaming}}" class="message-row msg-left">
    <text class="role-label">思考中</text>
    <view class="bubble bubble-streaming">
      <view class="typing-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>
  </view>

  <!-- AI 生成标识 -->
  <view wx:if="{{showAiLabel && messages.length > 0}}" class="ai-label">
    <text>以上内容为AI生成，仅供参考</text>
  </view>

  <view id="chat-bottom-anchor"></view>
</scroll-view>
